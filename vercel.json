{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<h>.*jolie.*)"
        }
      ],
      "destination": "https://madeleinejolie.com",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/multi-tier-pricing",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:slug",
      "has": [
        {
          "type": "host",
          "value": "(?<h>.*jolie.*)"
        }
      ],
      "destination": "/p/:slug"
    },
    {
      "source": "/:slug/:style",
      "has": [
        {
          "type": "host",
          "value": "(?<h>.*jolie.*)"
        }
      ],
      "destination": "/p/:slug/:style"
    }
  ]
}
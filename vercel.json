{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/multi-tier-pricing",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/welcome/:code",
      "destination": "/welcome"
    },
    {
      "source": "/start/:code",
      "destination": "/start"
    },
    {
      "source": "/start-thank-you/:code",
      "destination": "/start-thank-you"
    },
    {
      "source": "/connect-domain/:code",
      "destination": "/connect-domain"
    },
    {
      "source": "/key/:token",
      "destination": "/key"
    }
  ],
  "crons": [
    {
      "path": "/api/form-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/churn-check",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/auto-build",
      "schedule": "45 14 * * *"
    },
    {
      "path": "/api/weekly-update",
      "schedule": "0 20 * * 5"
    },
    {
      "path": "/api/review-inbox",
      "schedule": "10 * * * *"
    }
  ]
}
